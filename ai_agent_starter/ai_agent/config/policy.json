          "target_resource": "user_id: 3",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to delete Employee2 (ID:3) (admin-only)"
        },
        {
          "endpoint": "PUT:/api/users/23/role/",
          "attacker_user_id": 23,
          "target_resource": "own user_id: 23",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to escalate own role to admin"
        },
        {
          "endpoint": "POST:/api/payroll/",
          "attacker_user_id": 23,
          "target_resource": "admin-only endpoint",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to create payroll (admin-only)"
        },
        {
          "endpoint": "GET:/api/payroll/",
          "attacker_user_id": 23,
          "target_resource": "admin-only endpoint",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to view all payroll (admin-only)"
