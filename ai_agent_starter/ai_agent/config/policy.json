{
  "description": "Policy Configuration for BAC (Broken Access Control) Testing API - Defines RBAC rules, permissions, and endpoint access control per role",
  "rbac_rules": {
    "Admin": {
      "description": "Administrator with full system access and user management capabilities",
      "permissions": [
        "user_management",
        "rbac_admin",
        "view_all_documents",
        "payroll_management",
        "leave_management",
        "audit_access",
        "full_access"
      ],
      "allowed_endpoints": [
        "POST:/auth/login/",
        "POST:/auth/refresh/",
        "POST:/auth/logout/",
        "GET:/api/users/",
        "GET:/api/users/{user_id}/",
        "PUT:/api/users/{user_id}/",
        "DELETE:/api/users/{user_id}/",
        "PUT:/api/users/{user_id}/role/",
        "GET:/api/documents/",
        "POST:/api/documents/",
        "GET:/api/documents/{doc_id}/",
        "PUT:/api/documents/{doc_id}/",
        "DELETE:/api/documents/{doc_id}/",
        "GET:/api/documents/{doc_id}/download/",
        "GET:/api/payroll/",
        "POST:/api/payroll/",
        "GET:/api/payroll/{user_id}/",
        "PUT:/api/payroll/{user_id}/",
        "GET:/api/leaves/",
        "GET:/api/leaves/{leave_id}/",
        "PUT:/api/leaves/{leave_id}/approve/",
        "PUT:/api/leaves/{leave_id}/cancel/",
        "GET:/api/admin/audit-logs/",
        "GET:/api/admin/audit-logs/{user_id}/",
        "GET:/api/admin/dashboard/"
      ],
      "denied_endpoints": [],
      "critical_operations": [
        "DELETE:/api/users/{user_id}/",
        "PUT:/api/users/{user_id}/role/",
        "PUT:/api/payroll/{user_id}/"
      ]
    },
    "Employee": {
      "description": "Standard employee with limited access to own resources only",
      "permissions": [
        "view_own_profile",
        "update_own_profile",
        "manage_own_documents",
        "view_own_payroll",
        "manage_own_leaves"
      ],
      "allowed_endpoints": [
        "POST:/auth/login/",
        "POST:/auth/refresh/",
        "POST:/auth/logout/",
        "GET:/api/users/{user_id}/",
        "PUT:/api/users/{user_id}/",
        "GET:/api/documents/",
        "POST:/api/documents/",
        "GET:/api/documents/{doc_id}/",
        "PUT:/api/documents/{doc_id}/",
        "DELETE:/api/documents/{doc_id}/",
        "GET:/api/documents/{doc_id}/download/",
        "GET:/api/payroll/{user_id}/",
        "GET:/api/leaves/",
        "POST:/api/leaves/",
        "GET:/api/leaves/{leave_id}/",
        "PUT:/api/leaves/{leave_id}/",
        "PUT:/api/leaves/{leave_id}/cancel/"
      ],
      "denied_endpoints": [
        "GET:/api/users/",
        "DELETE:/api/users/{user_id}/",
        "PUT:/api/users/{user_id}/role/",
        "GET:/api/payroll/",
        "POST:/api/payroll/",
        "PUT:/api/payroll/{user_id}/",
        "PUT:/api/leaves/{leave_id}/approve/",
        "GET:/api/admin/audit-logs/",
        "GET:/api/admin/audit-logs/{user_id}/",
        "GET:/api/admin/dashboard/"
      ],
      "critical_deny": [
        "DELETE:/api/users/{user_id}/",
        "PUT:/api/users/{user_id}/role/",
        "POST:/api/payroll/",
        "PUT:/api/payroll/{user_id}/",
        "PUT:/api/leaves/{leave_id}/approve/",
        "GET:/api/admin/audit-logs/"
      ]
    }
  },
  "authentication_endpoints": {
    "description": "Special handling for authentication endpoints - these have different expected responses based on request data",
    "endpoints": {
      "login": {
        "endpoint": "POST:/auth/login/",
        "description": "User authentication endpoint",
        "requires_authentication": false,
        "requires_valid_credentials": true,
        "expected_responses": {
          "200": "Valid credentials provided (username + password)",
          "400": "Missing or malformed request body",
          "401": "Invalid credentials (wrong username/password)"
        },
        "evaluation_rule": "Should NOT be marked as FP when returning 401 - this is expected for invalid credentials"
      },
      "logout": {
        "endpoint": "POST:/auth/logout/",
        "description": "User logout endpoint",
        "requires_authentication": true,
        "requires_valid_token": true,
        "expected_responses": {
          "200": "Valid token provided in Authorization header",
          "401": "No token or invalid token in Authorization header"
        },
        "evaluation_rule": "Should NOT be marked as FP when returning 401 - this is expected without valid token"
      },
      "refresh": {
        "endpoint": "POST:/auth/refresh/",
        "description": "Token refresh endpoint",
        "requires_authentication": false,
        "requires_valid_refresh_token": true,
        "expected_responses": {
          "200": "Valid refresh token provided in request body",
          "400": "Missing refresh token in request body",
          "401": "Invalid or expired refresh token"
        },
        "evaluation_rule": "Should NOT be marked as FP when returning 401 - this is expected for invalid/expired refresh tokens"
      }
    },
    "important_notes": [
      "Auth endpoints are NOT truly 'public' - they have specific input requirements",
      "401 responses from auth endpoints are EXPECTED when requirements not met",
      "Evaluators should NOT count 401 from auth endpoints as False Positives",
      "These endpoints should be tested separately from IDOR/BOLA scenarios",
      "Auth endpoints are allowed for ALL roles but have different success criteria"
    ],
    "testing_guidelines": {
      "login_test": {
        "test_name": "Valid Login",
        "endpoint": "POST:/auth/login/",
        "request_body": {
          "username": "employee1",
          "password": "employee123"
        },
        "expected_response": 200,
        "should_receive_tokens": true
      },
      "login_test_invalid": {
        "test_name": "Invalid Login",
        "endpoint": "POST:/auth/login/",
        "request_body": {
          "username": "employee1",
          "password": "wrongpassword"
        },
        "expected_response": 401,
        "note": "This is NOT a false positive"
      },
      "logout_test": {
        "test_name": "Valid Logout",
        "endpoint": "POST:/auth/logout/",
        "headers": {
          "Authorization": "Bearer <valid_access_token>"
        },
        "expected_response": 200
      },
      "logout_test_no_token": {
        "test_name": "Logout Without Token",
        "endpoint": "POST:/auth/logout/",
        "headers": {},
        "expected_response": 401,
        "note": "This is NOT a false positive"
      }
    }
  },
  "idor_test_scenarios": {
    "horizontal_idor": {
      "description": "Employee tries to access another employee's resources",
      "attacker_role": "Employee",
      "victim_role": "Employee",
      "test_cases": [
        {
          "endpoint": "GET:/api/users/3/",
          "attacker_user_id": 23,
          "victim_user_id": 3,
          "target_resource": "user_id: 3",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to view Employee2's (ID:3) profile"
        },
        {
          "endpoint": "GET:/api/documents/5/",
          "attacker_user_id": 23,
          "victim_user_id": 3,
          "target_resource": "doc_id: 5 (owned by user 3)",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to view Employee2's (ID:3) document"
        },
        {
          "endpoint": "GET:/api/payroll/3/",
          "attacker_user_id": 23,
          "victim_user_id": 3,
          "target_resource": "user_id: 3",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to view Employee2's (ID:3) payroll"
        },
        {
          "endpoint": "PUT:/api/documents/5/",
          "attacker_user_id": 23,
          "victim_user_id": 3,
          "target_resource": "doc_id: 5 (owned by user 3)",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to edit Employee2's (ID:3) document"
        },
        {
          "endpoint": "DELETE:/api/documents/5/",
          "attacker_user_id": 23,
          "victim_user_id": 3,
          "target_resource": "doc_id: 5 (owned by user 3)",
          "expected_response": 403,
          "description": "Employee1 (ID:23) tries to delete Employee2's (ID:3) document"
        }
      ]
    },
