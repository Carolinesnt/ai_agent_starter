  "response_decision_flow": {
    "description": "How to decide between 403 Forbidden and 404 Not Found",
    "scenario_1_unauthorized_access": {
      "condition": "User tries to access existing resource owned by another user",
      "example": "Employee1 (ID:23) tries to GET /api/documents/5/ owned by Employee2 (ID:3)",
      "response": 403,
      "reason": "Resource exists but user doesn't have permission",
      "security_note": "Prevents information disclosure about resource existence"
    },
    "scenario_2_nonexistent_resource": {
      "condition": "User tries to access resource that doesn't exist in database",
      "example": "Any user tries to GET /api/documents/999/ (doesn't exist)",
      "response": 404,
      "reason": "Resource truly doesn't exist",
      "security_note": "Same response for admin and employee - no information disclosure"
    },
    "scenario_3_deleted_resource": {
      "condition": "User tries to access previously deleted resource",
      "example": "Any user tries to GET /api/users/1/ (deleted user)",
      "response": 404,
      "reason": "Resource no longer exists",
      "log_note": "Should be logged in audit trail"
    },
    "scenario_4_admin_privilege": {
      "condition": "Employee tries admin-only endpoint",
      "example": "Employee tries to DELETE /api/users/5/",
      "response": 403,
      "reason": "Insufficient privileges (vertical escalation attempt)",
      "security_note": "Should trigger security alert"
    },
    "implementation_order": {
      "step_1": "Check if user is authenticated (if not → 401)",
      "step_2": "Check if resource exists (if not → 404)",
      "step_3": "Check if user has permission to access resource (if not → 403)",
      "step_4": "Process request (→ 200/201)",
      "exception": "For security-critical operations, check permission BEFORE existence to prevent enumeration"
    }
  },
  "security_guidelines": [
    "Always return 403 Forbidden when user tries to access unauthorized resources",
    "Return 404 Not Found only when resource truly doesn't exist (prevents enumeration)",
    "Log all 403 responses in audit logs for security monitoring",
    "Validate user ownership on every request to resource-specific endpoints",
    "Never expose other users' data in error messages",
    "Check permissions before checking if resource exists",
    "Admin role should have access to all endpoints except where explicitly denied",
    "Employee role should only access own resources (user_id, document owner, etc.)"
  ],
